import matplotlib.pyplot as plt
import networkx as nx


G = nx.Graph()

conexiones = [
    ("Tacubaya", "Centro", {"peso": 4}),
    ("Centro", "Balderas", {"peso": 2}),
    ("Balderas", "Pino Suárez", {"peso": 3}),
    ("Pino Suárez", "Tacubaya", {"peso": 5}),
    ("Tacubaya", "Balderas", {"peso": 6}),  o
    ("Centro", "Pino Suárez", {"peso": 3})  
]
G.add_edges_from(conexiones)


ciclo_tsp = nx.approximation.traveling_salesman_problem(
    G, weight='peso', method=nx.approximation.christofides
)


tiempo_total = sum(
    G[u][v]['peso'] for u, v in zip(ciclo_tsp[:-1], ciclo_tsp[1:])
)

print("--- RED REDUCIDA: CIRCUITO HAMILTONIANO (TSP) ---")
print(f"Ruta del circuito: {' -> '.join(ciclo_tsp)}")
print(f"Tiempo total del recorrido: {tiempo_total} minutos\n")


plt.figure(figsize=(8, 5))
pos = nx.spring_layout(G, seed=42)


nx.draw_networkx_nodes(G, pos, node_size=1200, node_color="lightyellow", edgecolors="black")
nx.draw_networkx_edges(G, pos, width=2, edge_color="gray", style="dashed")
nx.draw_networkx_labels(G, pos, font_size=10, font_weight="bold")


aristas_tsp = list(zip(ciclo_tsp[:-1], ciclo_tsp[1:]))
nx.draw_networkx_edges(G, pos, edgelist=aristas_tsp, width=4, edge_color="red")


pesos = nx.get_edge_attributes(G, 'peso')
nx.draw_networkx_edge_labels(G, pos, edge_labels=pesos, font_size=9)

plt.title(
    "Modelo Reducido: Ciclo Hamiltoniano / TSP (4 Estaciones)\n"
    "Circuito cerrado resaltado en rojo",
    fontsize=11,
    fontweight="bold"
)
plt.axis("off")
plt.tight_layout()
plt.show()
