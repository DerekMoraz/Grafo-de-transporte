G = nx.Graph()

conexiones = []
for linea, estaciones in lineas_metro.items():
    for i in range(len(estaciones) - 1):
        origen = estaciones[i]
        destino = estaciones[i + 1]
        peso = 2 + ((i + len(linea)) % 3)
        conexiones.append((origen, destino, {"peso": peso, "linea": linea}))

G.add_edges_from(conexiones)

origen_ruta = "Tacubaya"
destino_ruta = "Pino Suárez"
ruta_corta = nx.shortest_path(G, source=origen_ruta, target=destino_ruta, weight="peso")
tiempo_total = sum(
    G[u][v]["peso"] for u, v in zip(ruta_corta[:-1], ruta_corta[1:])
)

print("--- RED METRO CDMX: RUTA MÁS CORTA ---")
print(f"Estaciones totales en el grafo: {G.number_of_nodes()}")
print(f"Conexiones totales en el grafo: {G.number_of_edges()}")
print(f"Ruta ({origen_ruta} -> {destino_ruta}): {' -> '.join(ruta_corta)}")
print(f"Tiempo estimado del tramo: {tiempo_total} minutos\n")

plt.figure(figsize=(14, 10))
pos = nx.spring_layout(G, seed=42, k=0.25)

nx.draw_networkx_nodes(
    G, pos, node_size=140, node_color="lightyellow", edgecolors="black", linewidths=0.7
)
nx.draw_networkx_edges(G, pos, width=1.2, edge_color="gray", style="dashed")
nx.draw_networkx_labels(G, pos, font_size=6.5, font_weight="bold")

aristas_ruta = list(zip(ruta_corta[:-1], ruta_corta[1:]))
nx.draw_networkx_nodes(
    G, pos, nodelist=ruta_corta, node_size=220, node_color="orange", edgecolors="black"
)
nx.draw_networkx_edges(G, pos, edgelist=aristas_ruta, width=3.5, edge_color="red")

plt.title(
    f"Red Metro CDMX - Grafo Completo\n"
    f"Ruta resaltada en rojo: {origen_ruta} -> {destino_ruta}",
    fontsize=12,
    fontweight="bold"
)
plt.axis("off")
plt.tight_layout()
plt.show()
